<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para mi Chiwawa - 126 Días Juntos 🌟💛</title>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #050309;
            min-height: 100vh;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Poppins', sans-serif;
            color: #fff;
        }

        /* Capas de Canvas separadas */
        #galaxyCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        #bouquetCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 2;
            pointer-events: none;
        }

        #interactiveCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 3;
            cursor: pointer;
        }

        /* Contador de días juntos (Esquina superior izquierda) */
        .counter-badge {
            position: absolute;
            top: 25px;
            left: 25px;
            z-index: 10;
            background: rgba(40, 15, 70, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 215, 0, 0.4);
            padding: 12px 22px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5),
                        0 0 20px rgba(255, 215, 0, 0.15);
            animation: fadeInBadge 1.5s ease-out forwards;
            opacity: 0;
            transform: translateY(-20px);
        }

        @keyframes fadeInBadge {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .counter-badge span {
            font-size: 1.3rem;
        }

        .counter-text {
            font-size: 0.85rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #f3e5f5;
            font-weight: 300;
        }

        .counter-text strong {
            color: #ffd700;
            font-weight: 600;
            font-size: 1rem;
        }

        /* Contenido Principal y Tarjeta */
        .content {
            position: relative;
            z-index: 10;
            text-align: center;
            max-width: 750px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            pointer-events: none;
            animation: floatContent 6s ease-in-out infinite;
        }

        @keyframes floatContent {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .card {
            background: rgba(30, 10, 50, 0.55);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 215, 0, 0.3);
            padding: 35px 45px;
            border-radius: 35px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.8),
                        0 0 50px rgba(138, 43, 226, 0.3);
            animation: cardEntrance 2s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            opacity: 0;
            transform: translateY(40px) scale(0.85);
            margin-top: 310px;
        }

        @keyframes cardEntrance {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        h1 {
            font-family: 'Dancing Script', cursive;
            font-size: clamp(2.8rem, 5.5vw, 4.5rem);
            color: #fff;
            text-shadow: 0 0 10px #fff,
                         0 0 20px #ffd700,
                         0 0 40px #ffd700,
                         0 0 80px #da70d6;
            line-height: 1.2;
            margin-bottom: 15px;
        }

        .subtext {
            font-size: 1.05rem;
            color: #f3e5f5;
            letter-spacing: 4px;
            text-transform: uppercase;
            font-weight: 300;
            opacity: 0.9;
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
        }

        .hint {
            position: absolute;
            bottom: 25px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.45);
            letter-spacing: 2px;
            animation: pulseHint 2.5s infinite ease-in-out;
            z-index: 10;
        }

        @keyframes pulseHint {
            0%, 100% { opacity: 0.3; }
            50% { opacity: 0.8; }
        }

        @media (max-width: 600px) {
            .counter-badge {
                top: 15px;
                left: 15px;
                padding: 8px 15px;
            }
            .counter-badge span { font-size: 1.1rem; }
            .counter-text { font-size: 0.75rem; }
        }
    </style>
</head>
<body>

    <!-- Contador de días -->
    <div class="counter-badge">
        <span>💛</span>
        <div class="counter-text">
            Juntos: <strong>126 días</strong>
        </div>
    </div>

    <!-- Capas de Canvas -->
    <canvas id="galaxyCanvas"></canvas>
    <canvas id="bouquetCanvas"></canvas>
    <canvas id="interactiveCanvas"></canvas>

    <div class="content">
        <div class="card">
            <h1>Pensabas que te iba a dejar sin flores amarillas chiwawa??</h1>
            <p class="subtext">¡Feliz día de las flores amarillas! 💛✨</p>
        </div>
    </div>

    <div class="hint">✨ Toca o haz clic en la galaxia para activar la magia ✨</div>

    <script>
        const galaxyCanvas = document.getElementById('galaxyCanvas');
        const galaxyCtx = galaxyCanvas.getContext('2d');
        const bouquetCanvas = document.getElementById('bouquetCanvas');
        const bouquetCtx = bouquetCanvas.getContext('2d');
        const interactiveCanvas = document.getElementById('interactiveCanvas');
        const interactiveCtx = interactiveCanvas.getContext('2d');

        let width, height;

        function resizeAll() {
            width = galaxyCanvas.width = bouquetCanvas.width = interactiveCanvas.width = window.innerWidth;
            height = galaxyCanvas.height = bouquetCanvas.height = interactiveCanvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeAll);
        resizeAll();

        // --- 1. FONDO GALAXIA ESPACIAL ---
        const stars = [];
        for (let i = 0; i < 500; i++) {
            stars.push({
                x: Math.random() * width,
                y: Math.random() * height,
                size: Math.random() * 1.8,
                speed: Math.random() * 0.04 + 0.01,
                color: Math.random() > 0.8 ? '#ffeb3b' : '#ffffff'
            });
        }

        let nebulaAngle = 0;

        function drawGalaxyBackground() {
            const bgGrad = galaxyCtx.createRadialGradient(width / 2, height / 2, 50, width / 2, height / 2, Math.max(width, height));
            bgGrad.addColorStop(0, '#2d0c4f');
            bgGrad.addColorStop(0.5, '#120524');
            bgGrad.addColorStop(1, '#030107');
            galaxyCtx.fillStyle = bgGrad;
            galaxyCtx.fillRect(0, 0, width, height);

            nebulaAngle += 0.0005;
            galaxyCtx.save();
            galaxyCtx.translate(width / 2, height / 2);
            galaxyCtx.rotate(nebulaAngle);

            let nebGrad1 = galaxyCtx.createRadialGradient(0, 0, 10, 0, 0, width * 0.6);
            nebGrad1.addColorStop(0, 'rgba(147, 51, 234, 0.22)');
            nebGrad1.addColorStop(0.5, 'rgba(88, 28, 135, 0.1)');
            nebGrad1.addColorStop(1, 'transparent');
            galaxyCtx.fillStyle = nebGrad1;
            galaxyCtx.fillRect(-width, -height, width * 2, height * 2);

            let nebGrad2 = galaxyCtx.createRadialGradient(-width * 0.1, -height * 0.1, 5, 0, 0, width * 0.4);
            nebGrad2.addColorStop(0, 'rgba(255, 215, 0, 0.18)');
            nebGrad2.addColorStop(0.6, 'rgba(186, 85, 211, 0.06)');
            nebGrad2.addColorStop(1, 'transparent');
            galaxyCtx.fillStyle = nebGrad2;
            galaxyCtx.fillRect(-width, -height, width * 2, height * 2);

            galaxyCtx.restore();

            stars.forEach(star => {
                star.y += star.speed;
                if (star.y > height) star.y = 0;

                galaxyCtx.beginPath();
                galaxyCtx.fillStyle = star.color;
                galaxyCtx.globalAlpha = Math.random() * 0.6 + 0.4;
                galaxyCtx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
                galaxyCtx.fill();
            });
            galaxyCtx.globalAlpha = 1.0;
        }

        // --- 2. MOTOR DE FLORES ULTRA-REALISTAS ---
        let bouquetProgress = 0;

        function drawRealisticFlower(ctx, x, y, radius, angle, time, depth) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(angle + Math.sin(time * 2.5 + x) * 0.02);

            // Factor de escala según profundidad (las del fondo son un poco más pequeñas y oscuras)
            const depthScale = depth === 'back' ? 0.8 : 1.0;
            ctx.scale(depthScale, depthScale);

            // Capa de pétalos exteriores con degradado realista (efecto 3D de relieve)
            const petals = 12;
            for (let i = 0; i < petals; i++) {
                ctx.save();
                ctx.rotate((i * 2 * Math.PI) / petals);
                
                // Degradado longitudinal para simular curvatura e iluminación en el pétalo
                let petalGrad = ctx.createLinearGradient(0, 0, 0, -radius * 1.4);
                petalGrad.addColorStop(0, depth === 'back' ? '#cca300' : '#e6b800'); // Base del pétalo más oscura
                petalGrad.addColorStop(0.4, depth === 'back' ? '#ffdb4d' : '#ffea6c'); // Color principal vivo
                petalGrad.addColorStop(1, depth === 'back' ? '#ffea80' : '#fff5b8'); // Punta iluminada

                ctx.beginPath();
                ctx.fillStyle = petalGrad;
                // Sutil sombra en cada pétalo para separación visual
                ctx.shadowColor = 'rgba(0, 0, 0, 0.3)';
                ctx.shadowBlur = 4;
                ctx.ellipse(0, -radius * 1.25, radius * 0.42, radius * 1.15, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            // Centro botánico complejo (pistilo y estambres)
            ctx.shadowBlur = 0;
            ctx.beginPath();
            let centerGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, radius * 0.55);
            centerGrad.addColorStop(0, '#ff9900');
            centerGrad.addColorStop(0.6, '#cc5500');
            centerGrad.addColorStop(1, '#551100');
            ctx.fillStyle = centerGrad;
            ctx.arc(0, 0, radius * 0.55, 0, Math.PI * 2);
            ctx.fill();

            // Textura granular del centro con pequeños estambres amarillos
            for(let j = 0; j < 8; j++) {
                let pAngle = j * ((Math.PI * 2) / 8);
                ctx.beginPath();
                ctx.fillStyle = '#ffeb3b';
                ctx.arc(Math.cos(pAngle) * (radius * 0.25), Math.sin(pAngle) * (radius * 0.25), 1.5, 0, Math.PI * 2);
                ctx.fill();
            }

            ctx.restore();
        }

        function renderBouquet() {
            bouquetCtx.clearRect(0, 0, width, height);

            const centerX = width / 2;
            const centerY = height * 0.31;

            if (bouquetProgress < 1) {
                bouquetProgress += 0.01;
            }
            const scale = Math.sin(bouquetProgress * Math.PI / 2);

            bouquetCtx.save();
            bouquetCtx.translate(centerX, centerY + 85);
            bouquetCtx.scale(scale, scale);
            bouquetCtx.globalAlpha = scale;

            // --- 1. Tallos realistas entrelazados ---
            bouquetCtx.strokeStyle = '#163d22';
            bouquetCtx.lineWidth = 5.5;
            bouquetCtx.lineCap = 'round';
            const stems = [
                {ex: 0, ey: 120}, {ex: -42, ey: 105}, {ex: 42, ey: 105},
                {ex: -22, ey: 130}, {ex: 22, ey: 130}, {ex: -65, ey: 90}, {ex: 65, ey: 90},
                {ex: -12, ey: 125}, {ex: 12, ey: 125}
            ];
            stems.forEach(s => {
                bouquetCtx.beginPath();
                bouquetCtx.moveTo(0, -10);
                bouquetCtx.quadraticCurveTo(s.ex * 0.4, 45, s.ex, s.ey);
                bouquetCtx.stroke();
            });

            // --- 2. Follaje y hojas detalladas con nervadura ---
            const leaves = [
                {x: -65, y: 35, rot: -0.7, scaleX: 1},
                {x: 65, y: 35, rot: 0.7, scaleX: -1},
                {x: -45, y: 70, rot: -0.4, scaleX: 0.9},
                {x: 45, y: 70, rot: 0.4, scaleX: -0.9}
            ];
            
            leaves.forEach(l => {
                bouquetCtx.save();
                bouquetCtx.translate(l.x, l.y);
                bouquetCtx.rotate(l.rot);
                bouquetCtx.scale(l.scaleX, 1);
                
                // Hoja verde con degradado natural
                let leafGrad = bouquetCtx.createLinearGradient(0, 0, 0, -30);
                leafGrad.addColorStop(0, '#10341a');
                leafGrad.addColorStop(0.5, '#2e8b57');
                leafGrad.addColorStop(1, '#3cb371');
                
                bouquetCtx.beginPath();
                bouquetCtx.fillStyle = leafGrad;
                bouquetCtx.ellipse(0, -15, 12, 28, 0, 0, Math.PI * 2);
                bouquetCtx.fill();

                // Nervadura central de la hoja
                bouquetCtx.strokeStyle = '#85e3a7';
                bouquetCtx.lineWidth = 1;
                bouquetCtx.beginPath();
                bouquetCtx.moveTo(0, 8);
                bouquetCtx.lineTo(0, -35);
                bouquetCtx.stroke();

                bouquetCtx.restore();
            });

            // --- 3. Envoltorio del ramo (Papel decorativo texturizado) ---
            bouquetCtx.beginPath();
            bouquetCtx.moveTo(-45, 60);
            bouquetCtx.lineTo(0, 165);
            bouquetCtx.lineTo(45, 60);
            bouquetCtx.closePath();
            bouquetCtx.fillStyle = 'rgba(147, 51, 234, 0.25)';
            bouquetCtx.fill();
            bouquetCtx.strokeStyle = 'rgba(255, 215, 0, 0.6)';
            bouquetCtx.lineWidth = 2.5;
            bouquetCtx.stroke();

            // Líneas de pliegue del papel de regalo
            bouquetCtx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
            bouquetCtx.lineWidth = 1;
            bouquetCtx.beginPath();
            bouquetCtx.moveTo(-20, 60);
            bouquetCtx.lineTo(-5, 140);
            bouquetCtx.moveTo(20, 60);
            bouquetCtx.lineTo(5, 140);
            bouquetCtx.stroke();

            // --- 4. Lazo y cinta satinada de doble bucle ---
            bouquetCtx.beginPath();
            bouquetCtx.fillStyle = '#e040fb';
            bouquetCtx.shadowColor = '#ff00ff';
            bouquetCtx.shadowBlur = 15;
            bouquetCtx.ellipse(-18, 72, 17, 10, -0.3, 0, Math.PI * 2);
            bouquetCtx.ellipse(18, 72, 17, 10, 0.3, 0, Math.PI * 2);
            bouquetCtx.fill();
            bouquetCtx.shadowBlur = 0;
            
            bouquetCtx.beginPath();
            bouquetCtx.arc(0, 73, 7, 0, Math.PI * 2);
            bouquetCtx.fillStyle = '#9c27b0';
            bouquetCtx.fill();

            bouquetCtx.beginPath();
            bouquetCtx.moveTo(-10, 78);
            bouquetCtx.quadraticCurveTo(-35, 110, -25, 145);
            bouquetCtx.moveTo(10, 78);
            bouquetCtx.quadraticCurveTo(35, 110, 25, 145);
            bouquetCtx.lineWidth = 6;
            bouquetCtx.strokeStyle = '#e040fb';
            bouquetCtx.stroke();

            // --- 5. Flores ordenadas en capas (Fondo y Frente) para realismo botánico ---
            const flowersData = [
                // Capa trasera (más oscuras y compactas)
                {x: -55, y: -45, size: 18, rot: 1.2, depth: 'back'},
                {x: 55, y: -45, size: 18, rot: -1.2, depth: 'back'},
                {x: -35, y: -100, size: 17, rot: 0.5, depth: 'back'},
                {x: 35, y: -100, size: 17, rot: -0.5, depth: 'back'},
                {x: -60, y: -70, size: 17, rot: 0.9, depth: 'back'},
                {x: 60, y: -70, size: 17, rot: -0.9, depth: 'back'},

                // Capa principal y delantera (vivas y grandes)
                {x: 0, y: -45, size: 25, rot: 0, depth: 'front'},
                {x: -45, y: -25, size: 21, rot: 0.2, depth: 'front'},
                {x: 45, y: -25, size: 21, rot: -0.2, depth: 'front'},
                {x: -25, y: -78, size: 23, rot: 0.7, depth: 'front'},
                {x: 25, y: -78, size: 23, rot: -0.7, depth: 'front'},
                {x: 0, y: -110, size: 20, rot: 0.1, depth: 'front'},
                {x: -50, y: 5, size: 17, rot: 1.5, depth: 'front'},
                {x: 50, y: 5, size: 17, rot: -1.5, depth: 'front'},
                {x: -22, y: -32, size: 20, rot: 0.4, depth: 'front'},
                {x: 22, y: -32, size: 20, rot: -0.4, depth: 'front'},
                {x: 0, y: -75, size: 21, rot: 0.3, depth: 'front'},
                {x: 0, y: -15, size: 19, rot: -0.2, depth: 'front'}
            ];

            const time = Date.now() * 0.002;
            flowersData.forEach((f, idx) => {
                drawRealisticFlower(bouquetCtx, f.x, f.y, f.size, f.rot, time + idx, f.depth);
            });

            bouquetCtx.restore();
        }

        // --- 3. INTERACTIVIDAD POR CLICS ---
        const interactiveEffects = [];

        window.addEventListener('pointerdown', (e) => {
            const count = 25;
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 8 + 2;
                interactiveEffects.push({
                    x: e.clientX,
                    y: e.clientY,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed - 2,
                    gravity: 0.12,
                    size: Math.random() * 9 + 3,
                    color: Math.random() > 0.4 ? '#ffd700' : '#e040fb',
                    alpha: 1.0,
                    decay: Math.random() * 0.018 + 0.01,
                    type: Math.random() > 0.5 ? 'petal' : 'star'
                });
            }
        });

        function renderInteractive() {
            interactiveCtx.clearRect(0, 0, width, height);

            for (let i = interactiveEffects.length - 1; i >= 0; i--) {
                let fx = interactiveEffects[i];
                fx.x += fx.vx;
                fx.y += fx.vy;
                fx.vy += fx.gravity;
                fx.alpha -= fx.decay;

                if (fx.alpha <= 0) {
                    interactiveEffects.splice(i, 1);
                    continue;
                }

                interactiveCtx.save();
                interactiveCtx.globalAlpha = fx.alpha;
                interactiveCtx.fillStyle = fx.color;
                interactiveCtx.beginPath();

                if (fx.type === 'petal') {
                    interactiveCtx.ellipse(fx.x, fx.y, fx.size, fx.size * 0.6, fx.vx, 0, Math.PI * 2);
                } else {
                    interactiveCtx.arc(fx.x, fx.y, fx.size * 0.5, 0, Math.PI * 2);
                }
                interactiveCtx.fill();
                interactiveCtx.restore();
            }
        }

        // --- BUCLE PRINCIPAL ---
        function mainLoop() {
            drawGalaxyBackground();
            renderBouquet();
            renderInteractive();
            requestAnimationFrame(mainLoop);
        }

        mainLoop();
    </script>
</body>
</html>
